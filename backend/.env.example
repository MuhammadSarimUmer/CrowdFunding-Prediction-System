# Copy to .env and fill in. .env is git-ignored.
#
# Neon connection string (direct endpoint, NOT "-pooler"):
#   postgresql://USER:PASSWORD@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
# JDBC form needs the jdbc: prefix:
#   jdbc:postgresql://ep-xxx.region.aws.neon.tech/neondb?sslmode=require
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/crowdpredict
SPRING_DATASOURCE_USERNAME=crowdpredict
SPRING_DATASOURCE_PASSWORD=crowdpredict
DB_POOL_SIZE=5

# At least 32 characters. Generate with: openssl rand -base64 48
JWT_SECRET=dev-only-secret-change-me-please-32-chars-min
JWT_TTL_MINUTES=1440

CORS_ORIGINS=http://localhost:5173
SEED_DEMO_DATA=true

DATASET_STORAGE_PATH=./data/datasets
MODEL_STORAGE_PATH=./data/models
LOG_STORAGE_PATH=./data/logs
