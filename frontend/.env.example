# Base URL for the CrowdPredict API. Keep /api to use the Vite dev proxy.
VITE_API_URL=/api

# The Vite dev server proxies /api to this origin.
VITE_PROXY_TARGET=http://localhost:5000

# Strip /api before forwarding. Set to false if your backend routes include /api.
VITE_PROXY_REWRITE=true

# Use the in-browser mock API (seeded demo data). Set to false to talk to a real backend.
VITE_USE_MOCK=true
